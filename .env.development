# Dev-only override, loaded by `next dev` BEFORE the plain .env (see Next.js's
# env file precedence: .env.development wins over .env for NODE_ENV=development,
# but never affects `next build`/production). Without this, a fresh checkout
# with no hand-made .env.local silently points bun run dev at .env's
# NEXT_PUBLIC_API_URL — which is the legacy sails backend, not soon — so the
# hardened SIWE nonce flow (server-persisted AuthCode) can't be exercised
# locally at all. See soon/design/CHANGELOG.md 2026-07-29.
NEXT_PUBLIC_API_URL=http://localhost:3000
